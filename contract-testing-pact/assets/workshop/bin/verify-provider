#!/usr/bin/env bash
# Verify a version of UserService against its consumers' contracts.
#
#   verify-provider <version> <pact-file>   check against a local pact file, publish nothing
#   verify-provider <version>               fetch contracts from the Pact Broker,
#                                           and publish the results there
set -euo pipefail
wait-for-setup
VERSION=${1:?usage: verify-provider <version> [pact-file]}
PACT_FILE=""
if [ -n "${2:-}" ]; then
  PACT_FILE=$(realpath "$2")
fi

IMAGE=user-service:$VERSION
NAME=user-service-verify

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "Building $IMAGE from Git tag $VERSION"
  git -C /root/workshop/user-service archive "$VERSION" | docker build -q -t "$IMAGE" - >/dev/null
fi

docker rm -f "$NAME" >/dev/null 2>&1 || true
trap 'docker rm -f "$NAME" >/dev/null 2>&1 || true' EXIT
docker run -d --name "$NAME" --network workshop \
  -e PROVIDER_STATES_FILE=/states/states.json \
  -v /root/workshop/provider-states:/states:ro \
  "$IMAGE" >/dev/null

for i in $(seq 1 30); do
  docker exec "$NAME" python -c "import urllib.request; urllib.request.urlopen('http://localhost:5000/health')" 2>/dev/null && break
  sleep 1
done

ARGS=(--hostname "$NAME" --port 5000
      --provider-name UserService
      --state-change-url "http://$NAME:5000/_pact/provider-states")

if [ -n "$PACT_FILE" ]; then
  echo "Verifying UserService $VERSION against $(basename "$PACT_FILE")"
  docker run --rm --network workshop -e PACT_DO_NOT_TRACK=true \
    -v "$PACT_FILE":/pact.json:ro \
    pactfoundation/pact-ref-verifier@sha256:514b680cd0ad2fa95c6df7a541e3b03c8dd1176de26e84e58a349de96e305bce "${ARGS[@]}" --file /pact.json
else
  echo "Verifying UserService $VERSION against contracts from the Pact Broker"
  # Which contracts to verify: the latest one from each OrderService branch.
  # (The "use-full-name" branch is created in step 5.)
  docker run --rm --network workshop -e PACT_DO_NOT_TRACK=true \
    pactfoundation/pact-ref-verifier@sha256:514b680cd0ad2fa95c6df7a541e3b03c8dd1176de26e84e58a349de96e305bce "${ARGS[@]}" \
    --broker-url http://broker:9292 \
    --consumer-version-selectors '{"branch": "main"}' \
    --consumer-version-selectors '{"branch": "use-full-name"}' \
    --publish --provider-version "$VERSION" --provider-branch main
fi