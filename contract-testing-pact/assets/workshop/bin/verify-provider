#!/usr/bin/env bash
# Verify a version of UserService against a contract (pact file).
# Usage: verify-provider <version> <pact-file>
#
# Starts that version of UserService with provider states enabled,
# then runs the Pact verifier against it.
set -euo pipefail
wait-for-setup
VERSION=${1:?usage: verify-provider <version> <pact-file>}
PACT_FILE=$(realpath "${2:?usage: verify-provider <version> <pact-file>}")

IMAGE=user-service:$VERSION
NAME=user-service-verify

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "Building $IMAGE from Git tag $VERSION"
  git -C /root/workshop/user-service archive "$VERSION" | docker build -q -t "$IMAGE" - >/dev/null
fi

docker rm -f "$NAME" >/dev/null 2>&1 || true
trap 'docker rm -f "$NAME" >/dev/null 2>&1 || true' EXIT
docker run -d --name "$NAME" --network workshop \
  -e PROVIDER_STATES_FILE=/states/states.json \
  -v /root/workshop/provider-states:/states:ro \
  "$IMAGE" >/dev/null

for i in $(seq 1 30); do
  docker exec "$NAME" python -c "import urllib.request; urllib.request.urlopen('http://localhost:5000/health')" 2>/dev/null && break
  sleep 1
done

echo "Verifying UserService $VERSION against $(basename "$PACT_FILE")"
docker run --rm --network workshop -v "$PACT_FILE":/pact.json:ro \
  -e PACT_DO_NOT_TRACK=true \
  pactfoundation/pact-ref-verifier:latest \
  --file /pact.json \
  --hostname "$NAME" --port 5000 \
  --provider-name UserService \
  --state-change-url "http://$NAME:5000/_pact/provider-states"